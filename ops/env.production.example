# Copy to ops/env.production.local and fill values in the deployment secret store.
# Never commit ops/env.production.local.

POSTGRES_DB=catlifepet
POSTGRES_USER=catlifepet
POSTGRES_PASSWORD=replace-with-managed-postgres-password

CATLIFEPET_SERVER_PORT=8080
CATLIFEPET_PUBLIC_BASE_URL=https://api.example.com
CATLIFEPET_JWT_SECRET=replace-with-at-least-32-random-characters
CATLIFEPET_TOKEN_PEPPER=replace-with-a-different-32-character-random-value
CATLIFEPET_JWT_ISSUER=catlifepet-server
CATLIFEPET_JWT_AUDIENCE=catlifepet-android

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true

DEEPSEEK_API_KEY=replace-in-secret-manager
CATLIFEPET_AI_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
CATLIFEPET_AI_TIMEOUT_SECONDS=30
CATLIFEPET_AI_MAX_INPUT_CHARACTERS=12000
CATLIFEPET_AI_MAX_OUTPUT_TOKENS=500
CATLIFEPET_AI_DAILY_REQUEST_LIMIT=100
CATLIFEPET_AI_USER_REQUESTS_PER_MINUTE=12
CATLIFEPET_AI_IP_REQUESTS_PER_MINUTE=40
CATLIFEPET_AI_CIRCUIT_FAILURE_THRESHOLD=5
CATLIFEPET_AI_CIRCUIT_OPEN_SECONDS=30

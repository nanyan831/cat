CATLIFEPET_ENV=development
CATLIFEPET_PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=jdbc:postgresql://localhost:5432/catlifepet
DATABASE_USER=catlifepet
DATABASE_PASSWORD=local-catlifepet-only
CATLIFEPET_JWT_SECRET=replace-with-a-long-random-development-secret
CATLIFEPET_TOKEN_PEPPER=replace-with-an-independent-random-pepper
CATLIFEPET_JWT_ISSUER=catlifepet-server
CATLIFEPET_JWT_AUDIENCE=catlifepet-android
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
OPENAI_API_KEY=replace-locally-never-commit-a-real-key
